# Credentials and keys must never be committed.
# Users supply their own; see custom_components/xpeng/certs/README.md
custom_components/xpeng/certs/*.pem
custom_components/xpeng/certs/*.crt
custom_components/xpeng/certs/*.der
custom_components/xpeng/certs/*.bks
custom_components/xpeng/xpeng_tokens.json
custom_components/xpeng/xpeng_tenant.json

# Captures hold raw broker traffic, which may include other vehicles' data.
# They are evidence, not source - regenerate them instead of committing them.
*.xpgcan
*.xpgcan.index.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local agent metadata
.serena/

# Compose environment for the standalone companions: it holds the account
# credentials and the Home Assistant token.
.env

# OS / editors
.DS_Store
.idea/
.vscode/

# Local architecture-explainer output (harness tooling, not source).
.archify/
